---
import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import '../styles/clinic.css';import '../styles/authored.css';import type{ClinicPage}from'../lib/types';
interface Props{page:ClinicPage}const{page}=Astro.props;const title=page.title+' | ИТВМ Арбат';
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><link rel="icon" href="favicon.svg" type="image/svg+xml"/><meta name="description" content={page.description}/><meta name="theme-color" content="#f8f9f5"/><meta name="generator" content="Astro v7.4.7 — independent clinic components"/><link rel="canonical" href={'https://itvm.ru/ever-youth/'+page.name}/><meta property="og:title" content={title}/><meta property="og:description" content={page.description}/><meta property="og:type" content="website"/><meta property="og:url" content={'https://itvm.ru/ever-youth/'+page.name}/>{page.alias&&<meta http-equiv="refresh" content={'0;url='+page.alias}/>}</head><body><Header current={page.name}/><main id="main"><slot/></main><Footer/></body></html>
