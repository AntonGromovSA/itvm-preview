---
import ClinicLayout from '../layouts/ClinicLayout.astro';
import ContentPage from '../components/ContentPage.astro';import AuthoredPage from '../components/AuthoredPage.astro';import compositions from '../data/compositions.json';
import { pages } from '../lib/content';
import ContactBookingPage from '../components/ContactBookingPage.astro';
import ExovesiclesPage from '../components/ExovesiclesPage.astro';
import ClinicAboutPage from '../components/ClinicAboutPage.astro';
export function getStaticPaths() {
  return pages.filter(p => !['index.html','404.html'].includes(p.name)).map(page => ({params: {path:page.name.replace(/\.html$/, '')},props:{page}}));
}
const { page } = Astro.props;
---
<ClinicLayout page={page}>{page.kind==='exovesicles'?<ExovesiclesPage/>:page.name==='page178631709.html'?<ClinicAboutPage/>:page.name==='page171084309.html'?<ContactBookingPage/>:page.name in compositions?<AuthoredPage page={page}/>:<ContentPage page={page}/>}</ClinicLayout>
