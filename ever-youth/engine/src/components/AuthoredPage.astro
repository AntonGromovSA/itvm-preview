---
import{readFileSync}from'node:fs';import{resolve}from'node:path';import{load}from'cheerio';
import compositionData from '../data/compositions.json';import{priceByRow,amount}from'../lib/content';import type{ClinicPage}from'../lib/types';
import '../styles/authored.css';
interface Props{page:ClinicPage}const{page}=Astro.props;
const entries=compositionData as Record<string,{htmlFile:string;css:string;hasH1:boolean}>;const entry=entries[page.name];
let html=entry?readFileSync(resolve('src/compositions',entry.htmlFile),'utf8'):'';
if(html.includes('data-source-row')){const $=load(html,{},false);$('tr[data-source-row]').each((_,el)=>{const row=$(el),item=priceByRow.get(Number(row.attr('data-source-row')));if(item){row.attr('data-price-row',String(item.sourceRow));row.find('td').first().text(item.name);row.find('td').last().text(amount(item.price));}});html=$.html();}
---
{entry&&<><link rel="stylesheet" href={'/ever-youth/'+entry.css}/>{!entry.hasH1&&page.kind!=='home'&&<h1 class="sr-only">{page.title}</h1>}<Fragment set:html={html}/></>}
<script>
 document.querySelectorAll<HTMLElement>('.authored-page').forEach(root=>{
  root.querySelectorAll<HTMLElement>('.authored-track').forEach(track=>{const controls=track.previousElementSibling;controls?.querySelector('[data-carousel-prev]')?.addEventListener('click',()=>track.scrollBy({left:-track.clientWidth,behavior:'smooth'}));controls?.querySelector('[data-carousel-next]')?.addEventListener('click',()=>track.scrollBy({left:track.clientWidth,behavior:'smooth'}));const carousel=track.closest('.carousel')||track.parentElement;carousel?.querySelectorAll<HTMLElement>('[data-slide-direction]').forEach(button=>{button.setAttribute('role','button');button.tabIndex=0;const go=()=>track.scrollBy({left:(button.dataset.slideDirection==='left'?-1:1)*track.clientWidth,behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'});button.addEventListener('click',go);button.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go();}});});});
  root.querySelectorAll<HTMLElement>('.art-rec').forEach(section=>{const tabs=[...section.querySelectorAll<HTMLElement>('[data-native-targets]')];if(!tabs.length)return;const all=new Set(tabs.flatMap(t=>(t.dataset.nativeTargets||'').split(',').filter(Boolean)));const choose=(value:string)=>{const selected=new Set(value.split(','));for(const id of all){const panel=document.getElementById('rec'+id);if(panel)panel.hidden=!selected.has(id);}for(const tab of tabs){const active=tab.dataset.nativeTargets===value;tab.classList.toggle('section1281__tab_active',active);tab.classList.toggle('section976__tab_active',active);const button=tab.querySelector<HTMLButtonElement>('button');if(button){button.setAttribute('aria-selected',String(active));button.tabIndex=active?0:-1;}}};tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>choose(tab.dataset.nativeTargets!));tab.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();const next=tabs[(index+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length];next.querySelector<HTMLButtonElement>('button')?.focus();choose(next.dataset.nativeTargets!);}});});section.querySelector<HTMLSelectElement>('select')?.addEventListener('change',event=>choose((event.target as HTMLSelectElement).value));choose(tabs[0].dataset.nativeTargets!);});
 });
</script>
