---
import {catalog,amount} from '../lib/content';
import clinic from '../data/clinic.json';
import '../styles/prices.css';
import navigation from '../data/price-navigation.json';
const labels:Record<string,string>=Object.fromEntries(navigation.map(c=>[c.id,c.title]));
const sections=navigation.map(c=>catalog.find(section=>section.id===c.id)!);
let initial=0;
---
<section class="container price-catalog" id="price-list">
 <form class="catalog-search" role="search" aria-label="Поиск услуг и цен"><label for="service-query">Какую услугу вы ищете?</label><div class="catalog-search-field"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="service-query" type="search" name="q" placeholder="Массаж, УЗИ или фамилия врача" autocomplete="off"/><button type="reset" class="catalog-reset" hidden aria-label="Очистить поиск">Сбросить</button></div></form>
 <div class="catalog-layout">
  <aside class="catalog-navigation"><p class="catalog-overline">Направления</p><label class="catalog-mobile-select" for="service-direction">Выберите направление<select id="service-direction">{sections.map(c=><option value={c.id}>{labels[c.id]}</option>)}</select></label><nav aria-label="Направления услуг">{sections.map(c=><button type="button" data-direction={c.id} aria-pressed={c.id==='center-3'}><span>{labels[c.id]}</span><span aria-hidden="true">↗</span></button>)}</nav><div class="catalog-help"><p>Поможем выбрать услугу</p><span>Администратор уточнит стоимость и подберёт время приёма.</span><a href={'tel:'+clinic.phones[0].e164}>{clinic.phones[0].display}</a></div></aside>
  <div class="catalog-results" id="service-results">
   <div class="catalog-heading"><div><p class="catalog-overline" id="catalog-kicker">Услуги клиники</p><h2 id="catalog-title" tabindex="-1">Реабилитация и восстановление</h2></div><p class="catalog-date">Прейскурант<br/><time datetime="2026-10-05">от 5 октября 2026</time></p></div>
   <div class="catalog-result-bar"><p role="status" aria-live="polite" id="price-status">Выберите услугу для записи на приём</p><label>Порядок услуг<select id="service-sort"><option value="default">По направлению</option><option value="asc">Сначала дешевле</option><option value="desc">Сначала дороже</option><option value="name">По алфавиту</option></select></label></div>
   <table class="service-list"><caption class="sr-only">Услуги института и цены по прейскуранту от 05.10.2026</caption><thead class="sr-only"><tr><th scope="col">Услуга</th><th scope="col">Запись</th><th scope="col">Стоимость</th></tr></thead><tbody>{sections.flatMap(c=>c.groups.flatMap(g=>g.items.map(i=>{
    const show=c.id==='center-3'&&initial++<12;
    return <tr hidden={!show} data-price-row={i.sourceRow} data-center={c.id} data-price={i.price===null?'':i.price} data-name={i.name} data-search={(c.title+' '+labels[c.id]+' '+g.title+' '+i.name+' '+i.code).toLocaleLowerCase('ru')}><td><span class="service-context">{g.title===c.title?labels[c.id]:g.title.replace(/\s*\/\s*/g,' · ').replace(/:\s*$/,'')}</span><span class="service-name">{i.name}</span></td><td class="service-book"><a href={'page170676909.html'} aria-label={'Записаться: '+i.name}>Записаться <span aria-hidden="true">↗</span></a></td><td class="service-price">{amount(i.price)}</td></tr>;
   })))}</tbody></table>
   <div class="catalog-empty" hidden><h3>Услуги не найдены</h3><p>Попробуйте более короткий запрос или уточните название у администратора.</p><a href={'tel:'+clinic.phones[0].e164}>Позвонить в клинику ↗</a></div>
   <nav class="catalog-pagination" aria-label="Страницы услуг"><button type="button" data-page-prev disabled aria-label="Предыдущая страница услуг">←</button><span id="catalog-page">Страница 1</span><button type="button" data-page-next aria-label="Следующая страница услуг">→</button></nav>
   <div class="catalog-footnote"><span aria-hidden="true">i</span><p>Стоимость указана за одну услугу, если в названии не отмечено иное. Подготовку к приёму и состав программы уточните у администратора.</p></div>
  </div>
 </div>
</section>
<script>
 const root=document.querySelector<HTMLElement>('.price-catalog');
 if(root){
  const input=root.querySelector<HTMLInputElement>('[name="q"]')!,form=root.querySelector<HTMLFormElement>('form')!,sort=root.querySelector<HTMLSelectElement>('#service-sort')!,mobile=root.querySelector<HTMLSelectElement>('#service-direction')!;
  const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-direction]')],rows=[...root.querySelectorAll<HTMLTableRowElement>('tr[data-price-row]')],tbody=root.querySelector('tbody')!,title=root.querySelector<HTMLElement>('#catalog-title')!,status=root.querySelector<HTMLElement>('#price-status')!,previous=root.querySelector<HTMLButtonElement>('[data-page-prev]')!,next=root.querySelector<HTMLButtonElement>('[data-page-next]')!;
  let direction='center-3',page=0;const size=12;
  const update=()=>{
   const words=input.value.trim().toLocaleLowerCase('ru').replace(/ё/g,'е').split(/\s+/).filter(Boolean),searching=words.length>0;
   const matches=rows.filter(r=>(searching||r.dataset.center===direction)&&words.every(w=>r.dataset.search!.replace(/ё/g,'е').includes(w)));
   if(sort.value==='asc'||sort.value==='desc')matches.sort((a,b)=>{const x=a.dataset.price===''?Infinity:Number(a.dataset.price),y=b.dataset.price===''?Infinity:Number(b.dataset.price);if(x===Infinity||y===Infinity)return x===y?0:x===Infinity?1:-1;return sort.value==='asc'?x-y:y-x;});
   if(sort.value==='name')matches.sort((a,b)=>a.dataset.name!.localeCompare(b.dataset.name!,'ru'));
   const pages=Math.max(1,Math.ceil(matches.length/size));page=Math.max(0,Math.min(page,pages-1));rows.forEach(r=>r.hidden=true);for(const row of matches.slice(page*size,(page+1)*size)){row.hidden=false;tbody.append(row);}
   title.textContent=searching?'Результаты поиска':buttons.find(b=>b.dataset.direction===direction)!.querySelector('span')!.textContent;root.querySelector('#catalog-kicker')!.textContent=searching?'По всем направлениям':'Услуги клиники';
   status.textContent=matches.length?`${page*size+1}–${Math.min((page+1)*size,matches.length)} из ${matches.length} услуг`:'Ничего не найдено';root.querySelector<HTMLElement>('.catalog-empty')!.hidden=matches.length>0;root.querySelector<HTMLElement>('.catalog-pagination')!.hidden=pages===1;root.querySelector('#catalog-page')!.textContent=`Страница ${page+1} из ${pages}`;previous.disabled=page===0;next.disabled=page===pages-1;
   root.querySelector<HTMLButtonElement>('.catalog-reset')!.hidden=!searching;buttons.forEach(b=>b.setAttribute('aria-pressed',String(!searching&&b.dataset.direction===direction)));mobile.value=direction;
   const params=new URLSearchParams();if(searching)params.set('q',input.value.trim());else params.set('center',direction);history.replaceState(null,'',location.pathname+'?'+params+location.hash);
  };
  const choose=(id:string)=>{direction=id;page=0;input.value='';sort.value='default';update();};buttons.forEach(b=>b.addEventListener('click',()=>choose(b.dataset.direction!)));mobile.addEventListener('change',()=>choose(mobile.value));input.addEventListener('input',()=>{page=0;update();});form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>queueMicrotask(()=>{page=0;update();input.focus();}));sort.addEventListener('change',()=>{page=0;update();});
  const turn=(delta:number)=>{page+=delta;update();title.focus({preventScroll:true});root.querySelector('#service-results')!.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'});};previous.addEventListener('click',()=>turn(-1));next.addEventListener('click',()=>turn(1));
  const params=new URLSearchParams(location.search);input.value=params.get('q')||'';if(buttons.some(b=>b.dataset.direction===params.get('center')))direction=params.get('center')!;update();
 }
</script>
