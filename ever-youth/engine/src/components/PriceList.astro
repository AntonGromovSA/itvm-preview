---
import{catalog,amount}from'../lib/content';
---
<section class="container section-space" id="price-list"><form class="price-controls" role="search" aria-label="Поиск и фильтрация услуг"><label>Поиск по услуге<input type="search" name="q" placeholder="Название услуги или фамилия врача"/></label><label>Раздел прайса<select name="center"><option value="">Все разделы</option>{catalog.map(c=><option value={c.id}>{c.title}</option>)}</select></label><label>Цена от, ₽<input name="min" type="number" min="0" inputmode="numeric"/></label><label>Цена до, ₽<input name="max" type="number" min="0" inputmode="numeric"/></label><button class="button button-outline" type="reset">Сбросить</button></form><div class="price-toolbar"><p role="status" id="price-status">В прайс-листе 1760 позиций в 14 разделах</p><button class="plain-button" data-expand>Раскрыть все</button><button class="plain-button" data-collapse>Свернуть все</button><button class="plain-button" data-print>Печать</button></div>{catalog.map(c=><section class="price-section" data-center={c.id}><h2>{c.title}</h2>{c.groups.map(g=><details><summary>{g.title}<span>Позиций: {g.items.length}</span></summary><div class="price-table-wrap"><table><caption class="sr-only">{g.title} — {c.title}</caption><thead><tr><th scope="col">Наименование услуги</th><th scope="col">Стоимость</th></tr></thead><tbody>{g.items.map(i=><tr data-price-row={i.sourceRow} data-price={i.price===null?'':i.price} data-search={(g.title+' '+i.name+' '+i.code).toLocaleLowerCase('ru')}><td>{i.name}</td><td>{amount(i.price)}</td></tr>)}</tbody></table></div></details>)}</section>)}<p class="price-note">Стоимость услуг — по прейскуранту от 05.10.2026. Цена указана за одну услугу, если не отмечено иное. Позиции без установленной цены уточняйте у администратора.</p></section>
<script>
 const form=document.querySelector<HTMLFormElement>('.price-controls');if(form){const q=form.elements.namedItem('q') as HTMLInputElement;const center=form.elements.namedItem('center') as HTMLSelectElement;const min=form.elements.namedItem('min') as HTMLInputElement;const max=form.elements.namedItem('max') as HTMLInputElement;const sections=[...document.querySelectorAll<HTMLElement>('[data-center]')];const status=document.querySelector('#price-status')!;
 const update=()=>{const words=q.value.trim().toLocaleLowerCase('ru').split(/\s+/).filter(Boolean);let total=0,centers=0;const filtered=words.length>0||!!center.value||!!min.value||!!max.value;for(const section of sections){let count=0;for(const group of section.querySelectorAll<HTMLDetailsElement>('details')){let found=0;for(const row of group.querySelectorAll<HTMLTableRowElement>('tr[data-price-row]')){const price=row.dataset.price;const value=Number(price);const show=(!center.value||center.value===section.dataset.center)&&words.every(w=>row.dataset.search!.includes(w))&&(!min.value||(price!==''&&value>=Number(min.value)))&&(!max.value||(price!==''&&value<=Number(max.value)));row.hidden=!show;if(show)found++;}group.hidden=found===0;if(filtered)group.open=found>0;count+=found;}section.hidden=count===0;total+=count;if(count)centers++;}status.textContent=filtered?`Найдено: ${total} из 1760 · Разделов: ${centers}`:'В прайс-листе 1760 позиций в 14 разделах';};
 form.addEventListener('input',update);form.addEventListener('change',update);form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>queueMicrotask(()=>{for(const section of sections)for(const d of section.querySelectorAll('details'))d.open=false;update();}));document.querySelector('[data-expand]')!.addEventListener('click',()=>document.querySelectorAll<HTMLDetailsElement>('.price-section details:not([hidden])').forEach(d=>d.open=true));document.querySelector('[data-collapse]')!.addEventListener('click',()=>document.querySelectorAll<HTMLDetailsElement>('.price-section details').forEach(d=>d.open=false));document.querySelector('[data-print]')!.addEventListener('click',()=>{document.querySelectorAll<HTMLDetailsElement>('.price-section details:not([hidden])').forEach(d=>d.open=true);window.print();});const params=new URLSearchParams(location.search);q.value=params.get('q')||'';if([...center.options].some(o=>o.value===params.get('center')))center.value=params.get('center')||'';update();
}
</script>
