---
import {doctors} from '../lib/content';
import Picture from './Picture.astro';
import ContactPanel from './ContactPanel.astro';
import '../styles/clinic-about.css';
const team=[['doctor-glavnyy-vrach.html','Главный врач института'],['doctor-shahova-dr.html','Гинеколог-репродуктолог, д.м.н., профессор'],['doctor-panov-gennadii-aleksandrovich.html','Невролог, рефлексотерапевт, к.м.н.']].map(([href,role])=>({person:doctors.find(d=>d.href===href)!,role}));
const directions=[
 {title:'Консультации врачей',text:'Специалисты института, направления приёма и образование.',href:'page172957109.html'},
 {title:'Диагностика',text:'Обследования и диагностические услуги института.',href:'page182655909.html'},
 {title:'Восстановительная медицина',text:'Консультации и процедуры восстановительного направления.',href:'page182686609.html'},
 {title:'Восточные методы',text:'Иглоукалывание, рефлексотерапия и другие методы клиники.',href:'page174904109.html'},
 {title:'Программы клиники',text:'Комплексные программы и этапы обращения.',href:'page168915909.html'},
 {title:'Palazzo Termale',text:'Термальный комплекс, водные процедуры и массаж.',href:'page171071209.html'}
];
const documents=[{label:'Лицензия на медицинскую деятельность',thumb:'media/da98a7be474b52-480.webp',full:'design-media/cce5a2005112058ae1e2.jpg'},{label:'Оборотная сторона лицензии',thumb:'media/dcea5465764338-480.webp',full:'design-media/91aa96a14ded87b92e46.jpg'},{label:'Приложение: виды медицинской деятельности',thumb:'media/76e5b111fa4160-480.webp',full:'design-media/58b1e7c621a5bb2aa06f.jpg'}];
---
<div class="clinic-about">
 <section class="container about-hero"><div class="breadcrumbs"><a href="index.html">Главная</a><span>/</span><span>Клиника</span></div><div class="about-hero-grid"><div><p class="eyebrow">Институт традиционной восточной медицины</p><h1>Клиника<br/>на Арбате</h1><p class="about-lead">Консультации врачей, диагностика и восстановительные процедуры в историческом центре Москвы.</p><p>В ИТВМ можно обратиться к специалисту, пройти обследование и обсудить план лечения. Здесь же, в Филипповском переулке, находится термальный комплекс Palazzo Termale.</p><div class="hero-actions"><a class="button" href="page171084309.html#appointment">Записаться на приём ↗</a><a class="text-link" href="page178607409.html">Услуги и цены ↗</a></div></div><figure><img src="media/55ed27da51b5c8-960.webp" srcset="media/55ed27da51b5c8-480.webp 480w, media/55ed27da51b5c8-960.webp 960w" sizes="(max-width:760px) 100vw, 50vw" width="960" height="640" alt="Зона приёма посетителей института" fetchpriority="high"/><figcaption>ИТВМ · Москва, Филипповский переулок, 18</figcaption></figure></div></section>
 <nav class="container about-nav" aria-label="Разделы страницы клиники"><a href="#institute">Об институте</a><a href="#care">Направления</a><a href="#first-visit">Первый приём</a><a href="#team">Врачи</a><a href="#clinic-video">Видео</a><a href="#documents">Документы</a></nav>
 <section class="container about-section about-intro" id="institute"><div><p class="eyebrow">Знакомство с ИТВМ</p><h2>Более 30 лет<br/>на Арбате</h2></div><div><p>Институт традиционной восточной и тибетской медицины — одна из первых клиник восточной медицины в Москве. Институт является клинической базой ИВМ РУДН.</p><p>В работе клиники представлены врачебные консультации, аппаратная диагностика и методы традиционной восточной медицины. После осмотра и изучения обследований врач объясняет, какие дальнейшие действия подходят в вашей ситуации.</p><p>Символ института связан с пятью элементами традиционной китайской медицины: водой, деревом, землёй, огнём и металлом. Эта идея отражена в гербе и оформлении сайта.</p></div></section>
 <section class="about-care-band" id="care"><div class="container about-section"><div class="about-section-head"><div><p class="eyebrow">Что есть в институте</p><h2>Направления клиники</h2></div><a class="text-link" href="page178642509.html">Полный каталог услуг ↗</a></div><div class="about-directions">{directions.map((item,index)=><a href={item.href}><span class="about-index">0{index+1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div><span aria-hidden="true">↗</span></a>)}</div></div></section>
 <section class="container about-section" id="first-visit"><div class="about-section-head"><div><p class="eyebrow">С чего начать</p><h2>Как проходит обращение</h2></div><p>Если вы не знаете, к кому записаться, расскажите администратору о цели визита — он поможет с выбором специалиста.</p></div><ol class="about-steps"><li><span>01</span><h3>Консультация</h3><p>Врач уточняет жалобы, историю обращений и изучает результаты обследований, которые уже есть у вас.</p></li><li><span>02</span><h3>Обследование по показаниям</h3><p>При необходимости специалист рекомендует дополнительные исследования и объясняет, для чего они нужны.</p></li><li><span>03</span><h3>План дальнейших действий</h3><p>Вы обсуждаете назначения, процедуры и последующее наблюдение. Стоимость услуг можно заранее посмотреть в прайсе.</p></li></ol><a class="text-link" href="page171084309.html#appointment">Выбрать время консультации ↗</a></section>
 <section class="container about-section" id="team"><div class="about-section-head"><div><p class="eyebrow">Команда института</p><h2>Кто принимает</h2></div><a class="text-link" href="page172957109.html">Все врачи и специалисты ↗</a></div><div class="about-team">{team.map(({person,role})=><article><a href={person.href}>{person.image&&<Picture image={person.image} sizes="(max-width:760px) 100vw, 30vw"/>}<h3>{person.name}</h3></a><p>{role}</p><a class="text-link" href={person.href}>Образование и приём ↗</a></article>)}</div></section>
 <section class="about-video-band" id="clinic-video"><div class="container about-section"><div class="about-section-head"><div><p class="eyebrow">Посмотрите перед визитом</p><h2>Знакомство с клиникой</h2></div><p>Видео об институте и его пространстве.</p></div><video controls playsinline preload="none" poster="media/55ed27da51b5c8-960.webp" aria-label="Видео об Институте традиционной восточной медицины"><source src="design-media/clinic-tour.mp4" type="video/mp4"/>Ваш браузер не поддерживает видео. <a href="design-media/clinic-tour.mp4">Открыть видео</a></video></div></section>
 <section class="container about-section about-visit"><div><p class="eyebrow">Планируете визит?</p><h2>Ждём вас<br/>в Филипповском переулке</h2></div><div><p>Москва, Филипповский переулок, 18. Около пяти минут пешком от метро Арбатская и Кропоткинская.</p><p>Пн–Сб · 09:00–21:00. По вопросам парковки и подготовки к обследованию свяжитесь с администратором.</p><a class="button button-outline" href="page171084309.html">Контакты и схема проезда ↗</a></div></section>
 <section class="container about-section about-documents" id="documents"><p class="eyebrow">Официальная информация</p><h2>Лицензия и реквизиты</h2><p>Лицензия № ЛО-77-01-018273 от 24.06.2019. Департамент здравоохранения города Москвы.</p><details><summary>Посмотреть лицензию и приложение <span>3 документа</span></summary><div class="about-doc-grid">{documents.map(doc=><a href={doc.full} target="_blank" rel="noopener noreferrer"><img src={doc.thumb} width="480" height="662" alt={doc.label} loading="lazy"/><span>{doc.label} ↗</span></a>)}</div></details><details><summary>Реквизиты организации</summary><dl><dt>Наименование</dt><dd>ООО «ИНСТИТУТ ТРАДИЦИОННОЙ ВОСТОЧНОЙ МЕДИЦИНЫ»</dd><dt>ОГРН</dt><dd>1057748436789</dd><dt>ИНН</dt><dd>7704572744</dd><dt>Адрес</dt><dd>119019, г. Москва, Филипповский переулок, д. 18</dd></dl></details></section>
 <ContactPanel/>
</div>
