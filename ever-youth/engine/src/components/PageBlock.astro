---
import { fragment } from '../lib/content';
import type { PageBlock, PageDefinition } from '../lib/types';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SlideShow from './SlideShow.astro';
import ModelViewer from './ModelViewer';
interface Props { block: PageBlock; page: PageDefinition }
const { block, page } = Astro.props;
---
{block.kind === 'header' && <Header file={block.file!} page={page} />}
{block.kind === 'footer' && <Footer file={block.file!} page={page} />}
{block.kind === 'legacy' && <Fragment set:html={fragment(block.file, page)} />}
{block.kind === 'slides' && <SlideShow slides={block.slides} label={block.label} id={block.id} />}
{block.kind === 'model' && <ModelViewer src={block.src} poster={block.poster} label={block.label} client:visible />}
