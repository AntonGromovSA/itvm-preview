---
import Picture from './Picture.astro';import VideoBlock from './VideoBlock.astro';import DoctorDirectory from './DoctorDirectory.astro';import ContactPanel from './ContactPanel.astro';import visuals from '../data/visuals.json';import{pageByName,photo}from'../lib/content';
const directions=[['Косметология','page182669909.html'],['Диагностика','page182655909.html'],['Восстановительная медицина','page182686609.html'],['Гинекология','page182699009.html'],['Неврология','page182706809.html'],['Педиатрия','page182714209.html'],['Терапия','page182718709.html'],['Кардиология','page182725309.html']];
const programs=[['Восстановление после операций','page172542009.html','Реабилитация после операций и травм.'],['Мужское и женское здоровье','page172935509.html','Индивидуальная программа после консультации врача.'],['Восстановление обоняния','page185646609.html','Институт обоняния и ольфакторной патологии.']];
---
<section class="home-hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Институт традиционной восточной медицины</p><h1>Восточная<br/>медицина<br/><em>на Арбате</em></h1><p>Консультации врачей, диагностика и восстановительные процедуры в историческом центре Москвы.</p><div class="hero-actions"><a class="button" href="page170676909.html">Записаться на приём <span>↗</span></a><a class="text-link" href="page178642509.html">Услуги института ↗</a></div></div><div class="hero-photo"><Picture image={visuals.clinic!} eager sizes="(max-width:760px) 100vw, 50vw"/><div class="photo-badge"><strong>30+</strong><span>лет работы<br/>в центре Москвы</span></div><div class="hero-caption"><span>Москва · Филипповский переулок, 18</span><a href="page178631709.html#clinic-video">Знакомство с клиникой ↗</a></div></div></div></section>
<div class="address-strip"><div class="container"><span>Филипповский переулок, 18 · м. Арбатская, Кропоткинская</span><span>Пн–Сб · 09:00–21:00</span><a href="page171084309.html">Контакты и как добраться ↗</a></div></div>
<section class="section-space"><div class="container"><div class="section-heading"><div><p class="eyebrow">Услуги института</p><h2>Направления приёма</h2></div><a class="text-link" href="page178642509.html">Все услуги ↗</a></div><div class="directions">{directions.map(([title,href])=><a class="direction" href={href}><span>{title}</span><span aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="section-space soft-section"><div class="container about-split"><div><p class="eyebrow">О клинике</p><h2>Консультации<br/>и лечение в ИТВМ</h2><p>После осмотра и обследования врач составляет план лечения и объясняет назначения.</p><a class="text-link" href="page178631709.html">Об институте ↗</a></div><div class="about-values"><div class="about-value"><span>01</span><div><h3>Консультация и диагностика</h3><p>Врачи восточной медицины, терапевты и специалисты по восстановлению.</p></div></div><div class="about-value"><span>02</span><div><h3>Методы восточной медицины</h3><p>Рефлексотерапия, иглоукалывание, лечебный массаж и другие направления института.</p></div></div><div class="about-value"><span>03</span><div><h3>Один адрес на Арбате</h3><p>Клиника и термальный комплекс Palazzo Termale в Филипповском переулке.</p></div></div></div></div></section>
<section class="section-space"><div class="container"><div class="section-heading"><div><p class="eyebrow">Лечение и восстановление</p><h2>Программы института</h2></div><a class="text-link" href="page168915909.html">Все программы ↗</a></div><div class="editorial-cards">{programs.map(([title,href,description])=>{const image=photo(pageByName(href));return <article class="editorial-card">{image&&<a href={href}><Picture image={{...image,alt:title}}/></a>}<h3><a href={href}>{title}</a></h3><p>{description}</p><a href={href}>О программе ↗</a></article>;})}</div></div></section>
<section class="section-space soft-section"><div class="container spa-feature"><div><VideoBlock video={{src:'video/clinic-tour.mp4',kind:'file',title:'Знакомство с Институтом традиционной восточной медицины'}} poster={visuals.clinic!}/></div><div><p class="eyebrow">Филипповский переулок, 18</p><h2>Клиника<br/>в центре Москвы</h2><p>Познакомьтесь с институтом перед первым визитом. Узнайте о направлениях приёма, специалистах и том, как проходит обращение.</p><a class="text-link" href="page178631709.html">Подробнее о клинике ↗</a><p style="margin-top:25px"><a href="page171071209.html">Palazzo Termale — термальный комплекс ↗</a></p></div></div></section>
<section class="section-space"><div class="container"><div class="section-heading"><div><p class="eyebrow">Команда института</p><h2>Наши специалисты</h2></div><a class="text-link" href="page172957109.html">Все специалисты ↗</a></div><DoctorDirectory limit={4}/></div></section><ContactPanel/>
