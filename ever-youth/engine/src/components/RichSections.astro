---
import type{ClinicPage}from'../lib/types';import{pages}from'../lib/content';import Picture from './Picture.astro';import VideoBlock from './VideoBlock.astro';import SlideShow from './SlideShow.astro';import ModelViewer from './ModelViewer';
interface Props{page:ClinicPage}const{page}=Astro.props;const meaningful=page.sections.filter(s=>s.html||s.images.length||s.videos.length||s.cards?.length||s.links.length||s.slides?.length||s.model);
---
{meaningful.map((section,index)=><section class="content-section" id={section.id==='details'?'details-'+index:section.id}><div class="container">{section.title&&section.title!==page.title&&<h2>{section.title}</h2>}{section.slides&&<SlideShow id={'slides-'+index} label={section.title||'Фотографии клиники'} slides={section.slides}/>} {section.model&&<ModelViewer src={section.model.src} poster={section.model.poster} label={section.model.label} client:visible/>} {section.html&&<div class="prose" set:html={section.html}/>} {section.cards&&<div class="editorial-cards">{section.cards.map(card=><article class="editorial-card">{card.image&&<Picture image={card.image}/>}<h3>{card.href?<a href={card.href}>{card.title}</a>:card.title}</h3>{card.text&&<p>{card.text}</p>}{card.href&&<a href={card.href}>Подробнее ↗</a>}</article>)}</div>}{section.videos.map(video=><VideoBlock video={video} poster={section.images[0]}/>)}{section.images.length>0&&<div class="section-gallery">{section.images.filter(p=>p.src!==page.portrait?.src).map(p=><a href={p.src}><Picture image={p} sizes="(max-width:760px) 45vw, 33vw"/></a>)}</div>}{section.links.length>0&&<div class="related-links">{section.links.map(link=><a href={link.href}>{pages.find(p=>p.name===link.href.split(/[?#]/)[0])?.title||link.title} <span aria-hidden="true">↗</span></a>)}</div>}</div></section>)}
