---
import type { Slide } from '../lib/types';
interface Props { id: string; label: string; slides: Slide[] }
const { id, label, slides } = Astro.props;
---
<clinic-slides class="clinic-slides" aria-label={label} role="region" data-component="slides">
  <div class="clinic-slides__controls">
    <button type="button" data-prev aria-label="Предыдущий слайд" aria-controls={id}>←</button>
    <span role="status" aria-live="polite" data-status>1 / {slides.length}</span>
    <button type="button" data-next aria-label="Следующий слайд" aria-controls={id}>→</button>
  </div>
  <div class="clinic-slides__track" id={id} tabindex="0">
    {slides.map((slide,index) => <article class="clinic-slides__item" role="group" aria-label={`${index+1} из ${slides.length}`}>
      <img src={slide.image} alt={slide.alt} loading="lazy" />
      {slide.title && <h3>{slide.title}</h3>}{slide.text && <p>{slide.text}</p>}
      {slide.href && <a href={slide.href}>Подробнее</a>}
    </article>)}
  </div>
</clinic-slides>
<script>
  class ClinicSlides extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const track=this.querySelector<HTMLElement>('.clinic-slides__track')!;
      const status=this.querySelector<HTMLElement>('[data-status]')!;
      const slides=Array.from(track.children) as HTMLElement[];
      const prev=this.querySelector<HTMLButtonElement>('[data-prev]')!;
      const next=this.querySelector<HTMLButtonElement>('[data-next]')!;
      let current=0;
      const update=()=>{current=Math.round(track.scrollLeft/Math.max(track.clientWidth,1));status.textContent=`${current+1} / ${slides.length}`;prev.disabled=current<=0;next.disabled=current>=slides.length-1;};
      const move=(delta:number)=>{const target=Math.max(0,Math.min(slides.length-1,current+delta));track.scrollTo({left:target*track.clientWidth,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});};
      prev.addEventListener('click',()=>move(-1));next.addEventListener('click',()=>move(1));
      track.addEventListener('scroll',update,{passive:true});track.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();move(event.key==='ArrowRight'?1:-1);}});update();
    }
  }
  if (!customElements.get('clinic-slides')) customElements.define('clinic-slides',ClinicSlides);
</script>
<style>
  .clinic-slides{display:block;max-width:1120px;margin:48px auto;color:#e9dfcf;font:16px/1.6 Onest,Arial,sans-serif}.clinic-slides__controls{display:flex;justify-content:flex-end;align-items:center;gap:20px;margin-bottom:18px}.clinic-slides button{background:transparent;color:inherit;border:1px solid #b89b72;padding:10px 18px;cursor:pointer}.clinic-slides button:disabled{opacity:.35;cursor:default}.clinic-slides__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin}.clinic-slides__item{flex:0 0 100%;scroll-snap-align:start;box-sizing:border-box}.clinic-slides img{display:block;width:100%;max-height:540px;object-fit:cover}.clinic-slides h3{font:400 30px/1.3 Prata,Georgia,serif}.clinic-slides a{color:inherit}.clinic-slides :focus-visible{outline:2px solid #d5bc94;outline-offset:4px}
</style>
