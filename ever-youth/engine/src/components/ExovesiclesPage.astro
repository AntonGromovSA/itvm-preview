---
import '../styles/exovesicles.css';
import {readFileSync} from 'node:fs';
const evidence=readFileSync('src/content/exovesicles-evidence.html','utf8');
---
<div class="exovesicle-page">
 <div class="science-story">
  <div class="scene-stage" data-scene="science" role="img" aria-label="Схематическая анимация ДНК, везикул и молекулярной среды"><img class="scene-fallback" src="brand/science-fallback.svg" alt="Схематическая двойная спираль ДНК и частицы"/><canvas aria-hidden="true"></canvas></div>
  <div class="science-controls"><button type="button" data-motion-toggle aria-pressed="false">Пауза анимации</button><span data-scene-status role="status"></span></div>
  <nav class="science-pagination" aria-label="Разделы об экзовезикулах"><a href="#science" data-science-chapter="0" aria-label="ДНК" aria-current="step">01</a><a href="#vesicles" data-science-chapter="1" aria-label="Везикулы">02</a><a href="#communication" data-science-chapter="2" aria-label="Межклеточная связь">03</a><a href="#research" data-science-chapter="3" aria-label="Исследования">04</a></nav>
  <section id="science" class="science-step science-hero" data-step="0"><div class="science-copy"><p class="eyebrow">Экзовезикулы / Масштаб невидимого</p><h1>Большой мир.<br/>Внутри малого.</h1><p class="science-lead">От светящихся нитей ДНК — к пространству молекул и мембран. Исследуйте микромир, скрытый от нашего взгляда.</p><p class="science-caption">ДНК и везикулы — разные объекты. Анимация показывает их схематически, в условном масштабе.</p><a class="text-link" href="#vesicles">Рассмотреть ближе ↓</a></div></section>
  <section id="vesicles" class="science-step" data-step="1"><div class="science-copy"><p class="eyebrow">01 / ВНЕКЛЕТОЧНЫЕ ВЕЗИКУЛЫ</p><h2>Оболочка.<br>И содержимое.</h2><p>Внеклеточные везикулы, или EV, — выделяемые клетками частицы с липидной оболочкой. Они не являются самостоятельными клетками и не размножаются. Их содержимое может включать белки, липиды и РНК.</p><p>Образ небольшой «посылки» помогает представить их роль: оболочка несёт молекулы, способные взаимодействовать с другими клетками.</p><a class="science-source" href="https://doi.org/10.1002/jev2.12404" target="_blank" rel="noopener noreferrer">Рекомендации MISEV2023 ↗</a></div><span class="object-label">02 / МЕМБРАННЫЕ ПУЗЫРЬКИ · СХЕМА</span></section>
  <section id="communication" class="science-step" data-step="2"><div class="science-copy"><p class="eyebrow">02 / МЕЖКЛЕТОЧНАЯ КОММУНИКАЦИЯ</p><h2>Связь между<br>клетками.</h2><p>Везикулы участвуют в межклеточном обмене. В экспериментах изучают перенос регуляторных РНК и изменения ответа клетки-получателя.</p><p>Результат зависит от источника частиц, их состава и условий взаимодействия. Название «экзосомы» само по себе не означает противовоспалительного или омолаживающего действия.</p><a class="science-source" href="https://www.nature.com/articles/ncomms9472" target="_blank" rel="noopener noreferrer">Phinney et al. · экспериментальное исследование ↗</a></div><span class="object-label">03 / МОЛЕКУЛЯРНАЯ СРЕДА · СХЕМА</span></section>
  <section id="research" class="science-step" data-step="3"><div class="science-copy"><p class="eyebrow">03 / НАПРАВЛЕНИЯ ИССЛЕДОВАНИЙ</p><h2>Потенциал.<br>И доказательства.</h2><p>Учёные исследуют участие EV в иммунной регуляции, восстановлении тканей и обмене митохондриальными компонентами. Есть лабораторные работы, опыты на животных и отдельные исследования у людей.</p><p>Каждый результат относится к определённому материалу и способу применения. Он не доказывает универсального омоложения или продления жизни человека.</p><a class="text-link" href="#evidence">Разобраться в исследованиях ↓</a></div></section>
 </div>
 <Fragment set:html={evidence}/><section class="science-offer"><p class="eyebrow">Консультация в ИТВМ</p><h2>Обсудить со специалистом</h2><p>Задайте вопросы о конкретном методе, его применении и доступных услугах института.</p><a class="button" href="page171084309.html#appointment">Запись и контакты ↗</a></section>
</div>
<script>
 const stage=document.querySelector<HTMLElement>('[data-scene="science"]');
 if(stage){
  const button=document.querySelector<HTMLButtonElement>('[data-motion-toggle]')!,status=document.querySelector<HTMLElement>('[data-scene-status]')!,preference=matchMedia('(prefers-reduced-motion:reduce)');
  let paused=preference.matches,chosen=false;
  const sync=()=>{button.setAttribute('aria-pressed',String(paused));button.textContent=paused?'Включить анимацию':'Пауза анимации';window.dispatchEvent(new CustomEvent('motion-change',{detail:paused}));};
  button.addEventListener('click',()=>{chosen=true;paused=!paused;sync();});preference.addEventListener('change',e=>{if(!chosen){paused=e.matches;sync();}});sync();
  const observer=new IntersectionObserver(async entries=>{if(entries.some(e=>e.isIntersecting)){observer.disconnect();try{const{createScene}=await import('../lib/science/science-scene');createScene(stage,paused);if(!stage.classList.contains('is-ready')){status.textContent='Статичная схема';button.hidden=true;}}catch{status.textContent='Статичная схема';button.hidden=true;}}},{rootMargin:'150px'});observer.observe(stage);
 }
</script>
