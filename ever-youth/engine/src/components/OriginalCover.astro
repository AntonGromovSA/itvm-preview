<script>const video=document.querySelector<HTMLVideoElement>('.original-background-video');const button=document.querySelector<HTMLButtonElement>('.cover-video-control');if(video&&button){const sync=()=>{button.setAttribute('aria-label',video.paused?'Включить фоновое видео':'Приостановить фоновое видео');button.innerHTML=video.paused?'▶ <span>Видео</span>':'Ⅱ <span>Пауза</span>';};button.addEventListener('click',()=>{if(video.paused)void video.play().catch(sync);else video.pause();});video.addEventListener('play',sync);video.addEventListener('pause',sync);video.addEventListener('loadedmetadata',()=>{void video.play().catch(sync);},{once:true});sync();}</script>
