---
import type{ClinicPage}from'../lib/types';import{priceByRow,amount,doctors}from'../lib/content';import Picture from './Picture.astro';import RichSections from './RichSections.astro';import ContactPanel from './ContactPanel.astro';import PriceList from './PriceList.astro';import DoctorDirectory from './DoctorDirectory.astro';import clinic from '../data/clinic.json';
interface Props{page:ClinicPage}const{page}=Astro.props;const doctor=page.kind==='doctor';const special=['prices','doctors','contacts','booking'].includes(page.kind);const intro=doctor?doctors.find(d=>d.href===page.name)?.role:page.kind==='prices'?'Услуги и стоимость по прейскуранту от 05.10.2026.':page.kind==='doctors'?'Врачи и специалисты института. Направления приёма, образование, опыт и стоимость услуг.':page.kind==='booking'?'Позвоните в клинику или напишите в WhatsApp. Администратор поможет выбрать специалиста и время приёма.':page.kind==='contacts'?clinic.address:page.description;
const rows=page.priceRows.map(id=>priceByRow.get(id)).filter((p):p is NonNullable<typeof p>=>!!p);
---
{page.alias?<section class="container section-space"><h1>{page.title}</h1><a class="button" href={page.alias}>Перейти на страницу ↗</a></section>:<><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="index.html">Главная</a><span>/</span>{doctor?<a href="page172957109.html">Специалисты</a>:<span>{page.kind==='prices'?'Услуги и цены':'Институт'}</span>}</div><div class:list={{'portrait-hero':doctor&&page.portrait}}><div><p class="eyebrow">{doctor?'Специалист института':'ИТВМ · Арбат'}</p><h1>{page.title}</h1>{intro&&<p class="page-lead">{intro}</p>}{!['booking','prices'].includes(page.kind)&&<div class="hero-actions"><a class="button" href="page170676909.html">Записаться на приём ↗</a>{doctor&&rows.length>0&&<a class="text-link" href="#doctor-prices">Услуги и цены ↓</a>}</div>}</div>{doctor&&page.portrait&&<Picture image={page.portrait} eager/>}</div></div></section>
{page.kind==='prices'&&<PriceList/>}
{page.kind==='doctors'&&<section class="container section-space"><DoctorDirectory/></section>}
{['contacts','booking'].includes(page.kind)&&<section class="container section-space contact-page-grid"><div class="contact-info"><p class="eyebrow">Телефоны клиники</p>{clinic.phones.map(p=><a href={'tel:'+p.e164}>{p.display}</a>)}<div class="contact-socials"><p class="eyebrow">Мессенджеры и соцсети</p><a href={clinic.whatsapp.url}>WhatsApp: {clinic.whatsapp.display} ↗</a><a href={clinic.vk} target="_blank" rel="noopener noreferrer">ВКонтакте ↗</a></div></div><div class="contact-map"><p class="eyebrow">Ждём вас на Арбате</p><h3>Филипповский<br/>переулок, 18</h3><p>Москва · м. Арбатская, Кропоткинская<br/>Пн–Сб · 09:00–21:00</p><p>Уточните у администратора подготовку к приёму и возможность парковки.</p><a class="button button-outline" href="https://yandex.ru/maps/?text=%D0%98%D0%A2%D0%92%D0%9C%20%D0%A4%D0%B8%D0%BB%D0%B8%D0%BF%D0%BF%D0%BE%D0%B2%D1%81%D0%BA%D0%B8%D0%B9%20%D0%BF%D0%B5%D1%80%D0%B5%D1%83%D0%BB%D0%BE%D0%BA%2018" target="_blank" rel="noopener noreferrer">Открыть на Яндекс Картах ↗</a></div></section>}
{!special&&<RichSections page={page}/>}
{rows.length>0&&<section class="container section-space" id="doctor-prices"><p class="eyebrow">По прейскуранту от 05.10.2026</p><h2>Приём и услуги</h2><div class="price-table-wrap"><table><thead><tr><th scope="col">Услуга</th><th scope="col">Стоимость</th></tr></thead><tbody>{rows.map(row=><tr data-price-row={row.sourceRow}><td>{row.name}</td><td>{amount(row.price)}</td></tr>)}</tbody></table></div><p class="price-note"><a class="text-link" href="page178607409.html">Все услуги и цены ↗</a></p></section>}
{!['booking','contacts','prices'].includes(page.kind)&&<ContactPanel/>}</>}
